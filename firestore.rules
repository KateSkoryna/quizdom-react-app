rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);

      // Users can create and update their own profile
      allow create, update: if isOwner(userId);

      // Users cannot delete their profile
      allow delete: if false;
    }

    // Quizzes collection
    match /quizes/{quizId} {
      // Anyone can read quizzes (public content)
      allow read: if true;

      // Only authenticated users can create quizzes
      allow create: if isSignedIn() &&
                      request.resource.data.authorId == request.auth.uid;

      // Only the author can update their quiz
      allow update: if isSignedIn() &&
                      resource.data.authorId == request.auth.uid;

      // Only the author can delete their quiz
      allow delete: if isSignedIn() &&
                      resource.data.authorId == request.auth.uid;
    }

    // Quiz completions collection
    match /quizCompletions/{completionId} {
      // Users can only read their own completions
      allow read: if isSignedIn() &&
                     resource.data.userId == request.auth.uid;

      // Users can create completions for themselves
      // (Cloud Functions can bypass these rules using Admin SDK)
      allow create: if isSignedIn() &&
                      request.resource.data.userId == request.auth.uid;

      // Users can update their own completions (for feedback)
      allow update: if isSignedIn() &&
                      resource.data.userId == request.auth.uid;

      // No one can delete completions
      allow delete: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
