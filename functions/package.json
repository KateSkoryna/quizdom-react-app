{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "genkit:ui": "genkit start --port 4001 -- npx tsx --watch src/genkit.ts",
    "genkit:emulator": "genkit start -- firebase emulators:start --inspect-functions"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/google-genai": "^1.26.0",
    "@google-cloud/firestore": "^7.11.6",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "genkit": "^1.26.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.0.40",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "typescript": "^5.1.0"
  }
}
