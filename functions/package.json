{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "genkit:ui": "genkit start --port 4001 -- npx tsx --watch src/genkit.ts",
    "genkit:emulatior": "genkit start -- firebase emulators:start --inspect-functions"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/google-genai": "^1.26.0",
    "dayjs": "^1.11.19",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "genkit": "^1.26.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/handlebars": "^4.0.40",
    "typescript": "^5.1.0"
  }
}
