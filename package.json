{
  "name": "quizdom-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\" \"functions/src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\" \"functions/src/**/*.{ts,tsx,js,jsx,json}\"",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "lighthouse:audit": "./lighthouse/scripts/audit.sh",
    "lighthouse:compare": "node lighthouse/scripts/compare.js",
    "lighthouse:view": "./lighthouse/scripts/view-latest.sh",
    "lighthouse:view:mobile": "./lighthouse/scripts/view-latest.sh mobile",
    "lighthouse:view:desktop": "./lighthouse/scripts/view-latest.sh desktop"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mapbox/search-js-react": "^1.5.0",
    "axios": "^1.13.2",
    "bcryptjs-react": "^2.4.6",
    "bootstrap": "^5.3.8",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.5",
    "firebase": "^12.6.0",
    "firebase-tools": "^13.9.0",
    "localforage": "^1.10.0",
    "match-sorter": "^8.2.0",
    "random-avatar-generator": "^2.0.0",
    "react": "^19.2.1",
    "react-datepicker": "^7.6.0",
    "react-dom": "^19.2.1",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.51.4",
    "react-icons": "^5.2.0",
    "react-lazy-load-image-component": "^1.6.0",
    "react-loader-spinner": "^8.0.0",
    "react-router-dom": "^6.23.0",
    "sort-by": "^1.2.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^20.12.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-lazy-load-image-component": "^1.6.4",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "lighthouse": "^13.0.1",
    "ngrok": "^5.0.0-beta.2",
    "prettier": "^3.7.4",
    "react-bootstrap": "^2.10.10",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.93.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-eslint": "^1.8.1"
  }
